<% layout("/layouts/boilarplate") %>
<style>
  :root {
    --primary:       #fe424d;
    --primary-dark:  #e0202c;
    --primary-light: #fff1f2;
    --accent:        #ff8a5c;
    --text:          #0f172a;
    --muted:         #64748b;
    --bg:            #f8fafc;
    --border:        #e2e8f0;
    --shadow-sm:     0 1px 2px rgba(15, 23, 42, .06);
    --shadow-md:     0 8px 24px rgba(15, 23, 42, .08);
  }

  /* ---------- PAGE HEADING ---------- */
  .form-head {
    margin-bottom: 24px;
  }
  .form-head h3 {
    position: relative;
    font-size: 1.65rem;
    font-weight: 800;
    letter-spacing: -.03em;
    color: var(--text);
    margin: 0 0 8px;
    padding-left: 16px;
  }
  .form-head h3::before {
    content: '';
    position: absolute;
    left: 0;
    top: 6px;
    bottom: 6px;
    width: 5px;
    border-radius: 4px;
    background: linear-gradient(180deg, var(--primary), var(--accent));
  }
  .form-head p {
    font-size: .92rem;
    color: var(--muted);
    margin: 0 0 0 16px;
  }

  /* ---------- FORM CARD ---------- */
  .form-card {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 34px 32px 28px;
    box-shadow: var(--shadow-sm);
    transition: box-shadow .25s ease, border-color .25s ease;
  }
  .form-card:hover {
    border-color: #ffc9ce;
    box-shadow: var(--shadow-md);
  }

  /* ---------- LABELS ---------- */
  .form-label {
    font-size: .74rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .06em;
    color: var(--muted);
    margin-bottom: 8px;
  }

  /* ---------- INPUTS ---------- */
  .form-control {
    width: 100%;
    padding: 12px 15px;
    border: 1px solid var(--border);
    border-radius: 11px;
    font-family: inherit;
    font-size: .93rem;
    color: var(--text);
    background: #fff;
    outline: none;
    transition: all .2s ease;
  }
  .form-control::placeholder {
    color: #94a3b8;
    font-size: .9rem;
  }
  .form-control:hover {
    border-color: #cbd5e1;
  }
  .form-control:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(254, 66, 77, .15);
    background: #fff;
  }

  /* hide number spinners */
  .form-control[type=number]::-webkit-outer-spin-button,
  .form-control[type=number]::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
  .form-control[type=number] { -moz-appearance: textfield; }

  /* ---------- FEEDBACK ---------- */
  .valid-feedback {
    color: #15803d;
    font-size: .8rem;
    font-weight: 600;
    margin-top: 6px;
  }
  .invalid-feedback {
    color: var(--primary);
    font-size: .8rem;
    font-weight: 600;
    margin-top: 6px;
  }

  .was-validated .form-control:invalid,
  .form-control.is-invalid {
    border-color: var(--primary);
    background-image: none;
  }
  .was-validated .form-control:valid,
  .form-control.is-valid {
    border-color: #22c55e;
    background-image: none;
  }

  /* ---------- ACTION BUTTONS ---------- */
  .form-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 22px;
  }

  .add-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    flex: 1 1 auto;
    padding: 13px 24px;
    border: none;
    border-radius: 11px;
    background: var(--primary);
    color: #fff;
    font-size: .95rem;
    font-weight: 700;
    letter-spacing: .01em;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(254, 66, 77, .3);
    transition: all .22s ease;
  }
  .add-btn:hover {
    background: var(--primary-dark);
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(254, 66, 77, .38);
  }
  .add-btn:active {
    transform: translateY(0);
    box-shadow: 0 4px 14px rgba(254, 66, 77, .3);
  }

  .cancel-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    flex: 1 1 auto;
    padding: 13px 24px;
    border: 1px solid var(--border);
    border-radius: 11px;
    background: #fff;
    color: var(--text);
    font-size: .95rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: all .22s ease;
  }
  .cancel-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
    background: var(--primary-light);
    transform: translateY(-2px);
  }

  /* ---------- FIELD SPACING ---------- */
  .mb-3 { margin-bottom: 20px !important; }
</style>

<body>
  <div class="row mt-4">
    <div class="col-12 col-md-10 col-lg-7 offset-md-1 offset-lg-2">

      <div class="form-head">
        <h3>Edit Your Listing</h3>
        <p>Update the details below and save your changes.</p>
      </div>

      <div class="form-card">
        <form method="post" action="/listings/<%= listing._id %>?_method=PUT" novalidate class="needs-validation">

          <!-- Item Name -->
          <div class="mb-3">
            <label for="title" class="form-label">Item Name</label>
            <input
              id="title"
              type="text"
              name="listing[name]"
              value="<%= listing.name %>"
              placeholder="e.g. Cable, Tape, Adapter"
              class="form-control"
              required
            />
            <div class="valid-feedback">Looks good!</div>
            <div class="invalid-feedback">Please enter an item name.</div>
          </div>

          <!-- Unit Price -->
          <div class="mb-3">
            <label for="image" class="form-label">Unit Price</label>
            <input
              id="image"
              type="number"
              name="listing[unitPrice]"
              value="<%= listing.unitPrice %>"
              min="0"
              step="0.01"
              placeholder="0.00"
              class="form-control"
            />
            <div class="valid-feedback">Unit price is optional.</div>
          </div>

          <!-- Supplier Email -->
          <div class="mb-3">
            <label for="price" class="form-label">Supplier Email</label>
            <input
              id="price"
              type="email"
              name="listing[supplier]"
              value="<%= listing.supplier %>"
              placeholder="supplier@example.com"
              class="form-control"
              required
            />
            <div class="invalid-feedback">Please enter a valid email.</div>
          </div>

          <!-- Actions -->
          <div class="form-actions">
            <a href="/listings/<%= listing._id %>" class="cancel-btn">Cancel</a>
            <button type="submit" class="add-btn">Save Changes</button>
          </div>

        </form>
      </div>

    </div>
  </div>

  <script src="/js/script.js"></script>
</body>