  <!-- ============ ANALYTICS / CHART ============ -->
<!-- ============ ANALYTICS / CHART ============ -->
<section class="section" style="padding-top: 0;">
  <div class="container">
    <div class="card">
      <div class="card-head">
        <div>
          <h2>📈 Usage Analytics</h2>
          <p>Units used over time (from <code>updatedAt</code>)</p>
        </div>

        <% if (activity.length > 0) { %>
          <div style="display:flex; gap:20px; flex-wrap:wrap;">
            <div>
              <div class="detail-label" style="margin:0;">Total Used</div>
              <div style="font-weight:800; font-size:1.1rem;"><%= totalUsed %></div>
            </div>
            <div>
              <div class="detail-label" style="margin:0;">Avg / Update</div>
              <div style="font-weight:800; font-size:1.1rem;"><%= avgUsed.toFixed(1) %></div>
            </div>
            <div>
              <div class="detail-label" style="margin:0;">Peak</div>
              <div style="font-weight:800; font-size:1.1rem;"><%= peakUsed %></div>
            </div>
          </div>
        <% } %>
      </div>

      <div class="card-body">
        <% if (activity.length > 0) { %>
          <div class="chart-wrap">
            <canvas id="usageChart"></canvas>
          </div>
        <% } else { %>
          <div class="empty-state">
            <div class="icon">📉</div>
            <h3>No usage data yet</h3>
            <p>This listing hasn't been updated since it was created.</p>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</section>

  <!-- ============ ACTIVITY LOG ============ -->
  <section class="section" style="padding-top: 0;">
    <div class="container">
      <div class="card">
        <div class="card-head">
          <h2>🕓 Update History</h2>
          <p>4 records</p>
        </div>

        <div class="table-scroll">
  <table>
    <thead>
      <tr>
        <th style="width:60px;">#</th>
        <th>Time</th>
        <th>Used</th>
        <th style="text-align:right;">Share of Total</th>
      </tr>
    </thead>
    <tbody>
      <% 
        // Show most recent first
        const reversedActivity = activity.slice().reverse();
        reversedActivity.forEach((entry, index) => {
          const used = Number(entry.used) || 0;
          const percent = totalUsed > 0 ? ((used / totalUsed) * 100).toFixed(1) : '0.0';
      %>
        <tr>
          <td><span class="idx"><%= activity.length - index %></span></td>
          <td><%= formatDate(entry.time, true) %></td>
          <td><span class="pill"><%= used %> units</span></td>
          <td style="text-align:right; color: var(--muted); font-weight:600;"><%= percent %>%</td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>

      </div>
    </div>
  </section>

  <!-- ============ ACTION BAR ============ -->
  <section class="section" style="padding-top: 0; padding-bottom: 60px;">
    <div class="container">
      <div class="action-bar">

        <div class="group">
          <a href="/listings" class="btn btn-outline">← Back to Listings</a>
          <a href="/listings/<%= listing._id %>/edit" class="btn btn-primary">✏️ Edit Listing</a>
        </div>

        <form 
          action="/listings/<%=listing._id%>?_method=DELETE" 
          method="POST" 
          onsubmit="return confirm('Delete this listing permanently? This cannot be undone.');"
          style="display:inline;"
        >
          <button type="submit" class="btn btn-ghost danger">🗑️ Delete Listing</button>
        </form>

      </div>
    </div>
  </section>

