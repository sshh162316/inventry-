<%
  // Safely get the updatedAt array (or empty array if missing)
  const activity = Array.isArray(listing.updatedAt) ? listing.updatedAt : [];

  // Sum all 'used' values; fallback to 0 if missing or invalid
  const totalUsed = activity.reduce((sum, entry) => sum + (Number(entry.used) || 0), 0);
  
  // Average per update (avoid division by zero)
  const avgUsed = activity.length ? (totalUsed / activity.length) : 0;

  // Peak single update
  const maxUsed = activity.length
    ? Math.max(...activity.map(e => Number(e.used) || 0))
    : 0;

  // Prepare data for Chart.js (sorted chronologically)
  const sortedActivity = activity
    .slice()
    .sort((a, b) => new Date(a.time) - new Date(b.time));

  const chartLabels = sortedActivity.map(a =>
    new Date(a.time).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })
  );
  const chartValues = sortedActivity.map(a => Number(a.used) || 0);
  const chartTimes  = sortedActivity.map(a =>
    new Date(a.time).toLocaleString('en-US', {
      month: 'short', day: 'numeric', year: 'numeric',
      hour: '2-digit', minute: '2-digit'
    })
  );

    // Extract all 'used' numbers, ignoring invalid entries
  const usedValues = activity
    .map(entry => Number(entry.used))
    .filter(n => !isNaN(n));

  // Peak = highest single 'used' value (0 if no data)
  const peakUsed = usedValues.length ? Math.max(...usedValues) : 0;

   // Helper for formatting dates (add if not already)
  function formatDate(date, withTime = false) {
    if (!date) return '—';
    const d = new Date(date);
    if (isNaN(d)) return '—';
    const options = {
      year: 'numeric',
      month: 'short',
      day: 'numeric'
    };
    if (withTime) {
      options.hour = '2-digit';
      options.minute = '2-digit';
    }
    return d.toLocaleString('en-US', options);
  }
%>
%>

<% layout("/layouts/boilarplate") %>
